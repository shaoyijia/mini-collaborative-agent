{
  "app": {
    "name": "Coco"
  },
  "services": [
    {
      "id": "tutor-server",
      "name": "Tutor Server",
      "enabled": true,
      "type": "python",
      "command": "uv",
      "args": [
        "run",
        "python",
        "-m",
        "proactive_tutor.tutor_server",
        "--port=8081",
        "--model_name=${TUTOR_MODEL}"
      ],
      "cwd": "${PROJECT_ROOT}",
      "shell": true,
      "restartOnCrash": true,
      "logPath": "${ELECTRON_UI_ROOT}/logs/tutor-server.log",
      "env": {
        "ANTHROPIC_API_KEY": ""
      }
    }
  ]
}
